---
import { getDictionary, getLocalizedText, type Locale } from '../lib/i18n';
import type { RotatedProviderItem } from '../lib/types/database';
import ShareButton from './ShareButton';
import { getSiteUrl } from '../lib/runtime/config';

interface Props {
  provider: RotatedProviderItem;
  locale: Locale;
  categoryName: string;
  talukaName: string;
}

const { provider, locale, categoryName, talukaName } = Astro.props;
const dict = getDictionary(locale);
const isMr = locale === 'mr';
const siteUrl = getSiteUrl(Astro.url.origin);
const localizedDescription = getLocalizedText(locale, provider.description_en, provider.description_mr);
const shareText = isMr
  ? `${dict.actions.sharePrompt} ${provider.provider_name} (${categoryName}), ${talukaName} येथे.`
  : `${dict.actions.sharePrompt} ${provider.provider_name} (${categoryName}) in ${talukaName}.`;

// Clean phone for tel: link
const telHref = `tel:${provider.mobile}`;

// WhatsApp link with friendly prefilled localized greeting
const waText = encodeURIComponent(
  isMr
    ? `नमस्कार ${provider.provider_name}, मी तुमची प्रोफाइल पाहिली. मला ${categoryName} कामाबद्दल चौकशी करायची आहे.`
    : `Hello ${provider.provider_name}, I found your profile on Aheka (aheka.in). I would like to inquire about ${categoryName} service.`
);
const waNumberClean = provider.whatsapp_number
  ? provider.whatsapp_number.replace(/[^\d]/g, '')
  : provider.mobile.replace(/[^\d]/g, '');
const waHref = `https://wa.me/${waNumberClean}?text=${waText}`;

// Initials for avatar fallback
const initials = provider.provider_name
  .split(' ')
  .slice(0, 2)
  .map(n => n.charAt(0))
  .join('');

const providerUrl = `${siteUrl}/${locale}/provider/${provider.slug}`;
---

<div class="bg-white dark:bg-ink-surface rounded-2xl border border-surface-border p-5 sm:p-6 shadow-soft hover:shadow-lift transition-all duration-200 flex flex-col justify-between group">
  <div>
    <!-- Top Row: Avatar & Identification -->
    <div class="flex items-start gap-4">
      <!-- Profile Photo or Branded Monogram Fallback (Policy: Single image) -->
      <div class="relative flex-shrink-0">
        {provider.profile_image_url ? (
          <img
            src={provider.profile_image_url}
            alt={`${provider.provider_name} - ${provider.business_name || categoryName}`}
            class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-cover border border-surface-border"
            loading="lazy"
            width="80"
            height="80"
          />
        ) : (
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-brand-50 dark:bg-brand-950/60 border border-brand-200 dark:border-brand-900/60 flex items-center justify-center text-brand-700 dark:text-brand-300 font-bold text-xl sm:text-2xl shadow-xs">
            {initials || 'A'}
          </div>
        )}

        {provider.is_verified && (
          <div
            class="absolute -bottom-1 -right-1 bg-green-600 text-white p-1 rounded-full shadow-xs"
            title={dict.directory.verifiedTooltip}
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
            </svg>
          </div>
        )}
      </div>

      <!-- Identity & Experience -->
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <a
            href={`/${locale}/provider/${provider.slug}`}
            class="font-bold text-base sm:text-lg text-ink-primary hover:text-brand-600 transition-colors truncate"
          >
            {provider.provider_name}
          </a>
          {provider.is_verified && (
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-green-50 text-green-700 border border-green-200">
              <span>✓ {isMr ? 'पडताळणी' : 'Verified'}</span>
            </span>
          )}
        </div>

        {provider.business_name && (
          <p class="text-xs sm:text-sm font-medium text-brand-700 mt-0.5 truncate">
            {provider.business_name}
          </p>
        )}

        <div class="flex items-center gap-3 mt-2 text-xs text-ink-muted flex-wrap">
          {provider.experience_years > 0 && (
            <span class="inline-flex items-center gap-1 bg-surface-muted px-2 py-0.5 rounded-md font-medium text-ink-secondary">
              <svg class="w-3.5 h-3.5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{provider.experience_years} {dict.directory.years} {dict.directory.experience}</span>
            </span>
          )}

          <span class="inline-flex items-center gap-1 text-ink-secondary truncate">
            <svg class="w-3.5 h-3.5 text-brand-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="truncate">{provider.full_address}</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Description Snippet -->
    {localizedDescription && (
      <p class="mt-3.5 text-xs sm:text-sm text-ink-secondary line-clamp-2 leading-relaxed">
        {localizedDescription}
      </p>
    )}
  </div>

  <!-- Bottom Actions: Call, WhatsApp, Directions, Share, View -->
  <div class="mt-5 pt-4 border-t border-surface-border flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-2 flex-wrap flex-1">
      <!-- Call Button -->
      <a
        href={telHref}
        data-vendor-id={provider.vendor_id}
        data-action="call_click"
        class="action-track-btn inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-semibold text-xs sm:text-sm shadow-xs transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>{dict.actions.callNow}</span>
      </a>

      <!-- WhatsApp Button -->
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        data-vendor-id={provider.vendor_id}
        data-action="whatsapp_click"
        class="action-track-btn inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#25D366] hover:bg-[#1ebd5a] active:bg-[#128C7E] text-white font-semibold text-xs sm:text-sm shadow-xs transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
        <span>{dict.actions.whatsapp}</span>
      </a>

      {provider.google_maps_url && (
        <a
          href={provider.google_maps_url}
          target="_blank"
          rel="noopener noreferrer"
          data-vendor-id={provider.vendor_id}
          data-action="directions_click"
          class="action-track-btn inline-flex items-center justify-center p-2 rounded-xl border border-surface-border text-ink-secondary hover:bg-surface-muted hover:text-ink-primary transition-colors"
          title={dict.actions.getDirections}
        >
          <svg class="w-4 h-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
        </a>
      )}

      <!-- Share Button -->
      <ShareButton
        client:idle
        title={`${provider.provider_name} - ${provider.business_name || categoryName}`}
        text={shareText}
        url={providerUrl}
        locale={locale}
      />
    </div>

    <!-- View Profile Link -->
    <a
      href={`/${locale}/provider/${provider.slug}`}
      class="text-xs font-semibold text-brand-700 hover:text-brand-800 hover:underline flex items-center gap-1 py-1"
    >
      <span>{dict.actions.viewProfile}</span>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>

<script>
  // Non-blocking analytics tracker for Call, WhatsApp and Directions clicks
  document.querySelectorAll<HTMLElement>('.action-track-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const vendorId = btn.dataset.vendorId;
      const action = btn.dataset.action;
      if (vendorId && action) {
        fetch('/api/analytics/event', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            vendor_id: vendorId,
            event_type: action,
            page_path: window.location.pathname,
            locale: window.location.pathname.split('/')[1] === 'mr' ? 'mr' : 'en',
          }),
        }).catch(() => {});
      }
    });
  });
</script>
