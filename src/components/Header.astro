---
import { getDictionary, LOCALE_PREFERENCE_COOKIE, type Locale } from '../lib/i18n';
import ThemeToggle from './ThemeToggle.astro';
import LogoIcon from './LogoIcon.astro';

interface Props {
  locale: Locale;
  currentPath?: string;
  currentTalukaName?: string;
}

const { locale, currentPath = '', currentTalukaName } = Astro.props;
const dict = getDictionary(locale);
const isMr = locale === 'mr';
const brandLabel = isMr ? dict.brand.devanagariName : dict.brand.name;
const primaryNavItems = [
  { href: `/${locale}`, label: dict.nav.home },
  { href: `/${locale}/services`, label: dict.nav.services },
  { href: `/${locale}/about`, label: dict.nav.about },
  { href: `/${locale}/contact`, label: dict.nav.contact },
];
const normalizedCurrentPath = currentPath.replace(/\/$/, '') || `/${locale}`;

// Alternate locale path
const alternateLocale: Locale = isMr ? 'en' : 'mr';
let alternatePath = currentPath;
if (currentPath.startsWith(`/${locale}`)) {
  alternatePath = currentPath.replace(`/${locale}`, `/${alternateLocale}`);
} else {
  alternatePath = `/${alternateLocale}${currentPath}`;
}

const localePreferenceCookie = LOCALE_PREFERENCE_COOKIE + '=' + alternateLocale + '; Path=/; Max-Age=31536000; SameSite=Lax';
---

<header class="sticky top-0 z-40 bg-white/95 dark:bg-ink-surface/95 backdrop-blur-md border-b border-surface-border">
  <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand Area -->
      <div class="flex items-center gap-3">
        <a
          href={`/${locale}`}
          class="flex items-center gap-2.5 group focus-visible:ring-2 focus-visible:ring-brand-500 rounded-xl p-1 notranslate"
          translate="no"
        >
          <LogoIcon size={38} className="w-9 h-9 sm:w-10 sm:h-10 rounded-xl shadow-soft group-hover:scale-105 transition-transform" />
          <div class="flex flex-col">
            <div class="notranslate" translate="no">
              <span class="text-xl sm:text-2xl font-black tracking-tight text-ink-primary">
                {brandLabel}
              </span>
            </div>
            <span class="text-[10px] sm:text-xs text-ink-muted -mt-0.5 font-medium">
              {dict.brand.tagline}
            </span>
          </div>
        </a>

        {currentTalukaName && (
          <button
            type="button"
            onclick="document.getElementById('location-dialog')?.showModal()"
            class="hidden lg:flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-muted hover:bg-surface-border text-xs font-semibold text-ink-secondary transition-colors border border-surface-border"
          >
            <svg class="w-3.5 h-3.5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="notranslate" translate="no">{currentTalukaName}</span>
            <span class="text-[10px] text-brand-700 dark:text-brand-400 underline ml-0.5">({dict.nav.changeLocation})</span>
          </button>
        )}
      </div>

      <!-- Primary customer navigation -->
      <nav class="hidden xl:flex items-center gap-0.5" aria-label={isMr ? 'मुख्य नेव्हिगेशन' : 'Main navigation'}>
        {primaryNavItems.map((item) => {
          const isActive = normalizedCurrentPath === item.href;
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class={`px-2.5 py-2 rounded-lg text-xs font-semibold transition-colors ${isActive
                ? 'bg-brand-50 dark:bg-brand-950/60 text-brand-700 dark:text-brand-300'
                : 'text-ink-secondary hover:text-ink-primary hover:bg-surface-muted'}`}
            >
              {item.label}
            </a>
          );
        })}
        <button
          type="button"
          onclick="document.getElementById('location-dialog')?.showModal()"
          class="px-2.5 py-2 rounded-lg text-xs font-semibold text-ink-secondary hover:text-ink-primary hover:bg-surface-muted transition-colors"
        >
          {dict.nav.chooseLocation}
        </button>
      </nav>

      <!-- Desktop Right Navigation & CTAs -->
      <div class="hidden sm:flex items-center gap-3 lg:gap-4">
        <!-- Theme Toggle (Light | Dark | System) -->
        <ThemeToggle locale={locale} storageKey="aheka_theme" />

        <!-- Language Switcher -->
        <a
          href={alternatePath}
          onclick={"document.cookie = " + JSON.stringify(localePreferenceCookie)}
          class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold rounded-xl border border-surface-border bg-surface-muted hover:bg-white dark:hover:bg-ink-border text-ink-primary transition-all shadow-2xs"
          title={isMr ? 'इंग्रजीमध्ये बदला' : 'Switch to Marathi'}
        >
          <span>{isMr ? 'इंग्रजी' : 'Marathi'}</span>
        </a>

        <!-- List Your Service CTA -->
        <a
          href={`/${locale}/join`}
          class="inline-flex items-center justify-center bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-xl transition-all shadow-sm hover:shadow-md"
        >
          {dict.nav.join}
        </a>
      </div>

      <!-- Mobile Right Area: Menu Toggle Button -->
      <div class="flex xl:hidden items-center gap-2">
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 text-ink-secondary hover:text-ink-primary hover:bg-surface-muted rounded-xl transition-colors border border-surface-border"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
          aria-label={isMr ? 'मेन्यू उघडा' : 'Toggle navigation menu'}
        >
          <svg id="hamburger-icon" class="w-5 h-5 text-ink-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-5 h-5 text-ink-primary hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile and tablet navigation drawer -->
  <div
    id="mobile-nav-panel"
    class="hidden xl:hidden border-t border-surface-border bg-white/95 dark:bg-ink-surface/95 backdrop-blur-md px-4 py-4 space-y-3 shadow-lg"
  >
    <!-- Customer navigation comes first, before the provider action. -->
    <nav class="space-y-1" aria-label={isMr ? 'मुख्य नेव्हिगेशन' : 'Main navigation'}>
      {primaryNavItems.map((item) => {
        const isActive = normalizedCurrentPath === item.href;
        return (
          <a
            href={item.href}
            data-mobile-nav-close
            aria-current={isActive ? 'page' : undefined}
            class={`mobile-nav-link flex items-center justify-between w-full px-3.5 py-3 rounded-xl text-sm font-semibold transition-colors ${isActive
              ? 'bg-brand-50 dark:bg-brand-950/60 text-brand-700 dark:text-brand-300'
              : 'text-ink-primary hover:bg-surface-muted'}`}
          >
            <span>{item.label}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        );
      })}
      <button
        type="button"
        data-mobile-nav-close
        onclick="document.getElementById('location-dialog')?.showModal()"
        class="mobile-nav-link flex items-center justify-between w-full px-3.5 py-3 rounded-xl text-sm font-semibold text-ink-primary hover:bg-surface-muted transition-colors"
      >
        <span>{dict.nav.chooseLocation}</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21s7-5.25 7-12a7 7 0 10-14 0c0 6.75 7 12 7 12z" />
          <circle cx="12" cy="9" r="2.25" stroke-width="2" />
        </svg>
      </button>
    </nav>

    <!-- Provider Onboarding CTA -->
    <a
      href={`/${locale}/join`}
      data-mobile-nav-close
      class="flex items-center justify-center w-full bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-bold text-sm py-3 px-4 rounded-xl shadow-sm transition-colors text-center"
    >
      {dict.nav.join}
    </a>

    <!-- Controls Row: Language Switch & Theme Toggle -->
    <div class="flex items-center justify-between pt-2 border-t border-surface-border">
      <!-- Language Switch -->
      <a
        href={alternatePath}
        onclick={"document.cookie = " + JSON.stringify(localePreferenceCookie)}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg border border-surface-border bg-surface-muted hover:bg-white dark:hover:bg-ink-border text-ink-primary transition-all shadow-2xs"
      >
        <span class="text-ink-muted text-[10px]">{isMr ? 'भाषा:' : 'Language:'}</span>
        <span class="font-bold text-brand-600 dark:text-brand-400">{isMr ? 'इंग्रजी' : 'Marathi'}</span>
      </a>

      <!-- Theme Toggle -->
      <div class="flex items-center gap-2">
        <ThemeToggle locale={locale} storageKey="aheka_theme" />
      </div>
    </div>

    {currentTalukaName && (
      <div class="pt-2 border-t border-surface-border flex items-center justify-end text-xs">
        <button
          type="button"
          onclick="document.getElementById('location-dialog')?.showModal()"
          class="text-brand-600 dark:text-brand-400 hover:underline font-medium py-1"
        >
          📍 <span class="notranslate" translate="no">{currentTalukaName}</span> ({dict.nav.changeLocation})
        </button>
      </div>
    )}
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const panel = document.getElementById('mobile-nav-panel');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!btn || !panel) return;

    const closeMenu = () => {
      btn.setAttribute('aria-expanded', 'false');
      panel.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    };

    btn.onclick = () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
        return;
      }
      btn.setAttribute('aria-expanded', 'true');
      panel.classList.remove('hidden');
      hamburgerIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
    };

    document.querySelectorAll<HTMLElement>('[data-mobile-nav-close]').forEach((item) => {
      item.addEventListener('click', closeMenu);
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
