---
interface Props {
  size?: number | string;
  className?: string;
}

const { size = 40, className = '' } = Astro.props;
const uid = Math.random().toString(36).substring(2, 6);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class={`flex-shrink-0 select-none ${className}`}
  role="img"
  aria-label="Aheka Logo"
>
  <defs>
    <linearGradient id={`aheka-grad-${uid}`} x1="15%" y1="0%" x2="85%" y2="100%">
      <stop offset="0%" stop-color="#ff7f11" />
      <stop offset="55%" stop-color="#e65100" />
      <stop offset="100%" stop-color="#bf360c" />
    </linearGradient>
    <linearGradient id={`aheka-sheen-${uid}`} x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.25" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>
  </defs>

  <!-- Modern Squircle Background -->
  <rect width="100" height="100" rx="24" fill={`url(#aheka-grad-${uid})`} />
  <rect x="1" y="1" width="98" height="48" rx="23" fill={`url(#aheka-sheen-${uid})`} />

  <!-- Discovery / Signal Radar Waves (Top) -->
  <path
    d="M 33 34 A 22 22 0 0 1 67 34"
    fill="none"
    stroke="#ffffff"
    stroke-opacity="0.45"
    stroke-width="4.5"
    stroke-linecap="round"
  />
  <path
    d="M 39 40 A 14 14 0 0 1 61 40"
    fill="none"
    stroke="#ffffff"
    stroke-opacity="0.75"
    stroke-width="4"
    stroke-linecap="round"
  />

  <!-- The Modern Aheka 'A' + Location Pin + Discovery Emblem -->
  <!-- Outer Location Pin sweeping arms -->
  <path
    d="M 35 34 C 31 42 30 54 36 65 L 50 82 L 64 65 C 70 54 69 42 65 34"
    fill="none"
    stroke="#ffffff"
    stroke-width="5.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- Central 'A' Apex & Crossbar -->
  <line x1="38" y1="60" x2="62" y2="60" stroke="#ffffff" stroke-width="5" stroke-linecap="round" />
  <line x1="50" y1="44" x2="31" y2="73" stroke="#ffffff" stroke-width="5.5" stroke-linecap="round" />
  <line x1="50" y1="44" x2="69" y2="73" stroke="#ffffff" stroke-width="5.5" stroke-linecap="round" />

  <!-- Beacon Core Dot -->
  <circle cx="50" cy="44" r="4.5" fill="#ffffff" />
</svg>
