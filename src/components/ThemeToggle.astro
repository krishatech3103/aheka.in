---
import { getDictionary, type Locale, DEFAULT_LOCALE } from '../lib/i18n';

interface Props {
  locale?: Locale;
  storageKey?: string;
  className?: string;
}

const {
  locale = DEFAULT_LOCALE,
  storageKey = 'aheka_theme',
  className = '',
} = Astro.props;

const dict = getDictionary(locale);
const uid = Math.random().toString(36).substring(2, 7);
---

<div class={`relative inline-block theme-toggle-container ${className}`} data-storage-key={storageKey} id={`theme-toggle-root-${uid}`}>
  <!-- Theme Toggle Button -->
  <button
    type="button"
    id={`theme-btn-${uid}`}
    aria-label={dict.theme.toggle}
    aria-haspopup="menu"
    aria-expanded="false"
    class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-surface-border bg-surface-muted hover:bg-surface-border text-ink-primary transition-all text-xs font-semibold shadow-2xs focus-visible:ring-2 focus-visible:ring-brand-500"
  >
    <!-- Sun Icon (Light) -->
    <svg class="w-4 h-4 text-amber-500 theme-icon-light hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>

    <!-- Moon Icon (Dark) -->
    <svg class="w-4 h-4 text-indigo-400 theme-icon-dark hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>

    <!-- System / Monitor Icon -->
    <svg class="w-4 h-4 text-ink-secondary theme-icon-system" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>

    <span class="sr-only sm:not-sr-only text-[11px] font-medium text-ink-secondary theme-label">
      {dict.theme.system}
    </span>

    <svg class="w-3 h-3 text-ink-muted -mr-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    id={`theme-menu-${uid}`}
    role="menu"
    aria-orientation="vertical"
    class="hidden absolute right-0 top-full mt-1.5 w-36 rounded-2xl border border-surface-border bg-white shadow-lift p-1.5 z-50 transition-all duration-150"
  >
    <!-- Light Option -->
    <button
      type="button"
      role="menuitem"
      data-theme-value="light"
      class="theme-option-btn w-full flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-semibold text-ink-primary hover:bg-surface-muted transition-colors text-left"
    >
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <span>{dict.theme.light}</span>
      </span>
      <span class="theme-check-icon hidden text-brand-600 font-bold">✓</span>
    </button>

    <!-- Dark Option -->
    <button
      type="button"
      role="menuitem"
      data-theme-value="dark"
      class="theme-option-btn w-full flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-semibold text-ink-primary hover:bg-surface-muted transition-colors text-left"
    >
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <span>{dict.theme.dark}</span>
      </span>
      <span class="theme-check-icon hidden text-brand-600 font-bold">✓</span>
    </button>

    <!-- System Option -->
    <button
      type="button"
      role="menuitem"
      data-theme-value="system"
      class="theme-option-btn w-full flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-semibold text-ink-primary hover:bg-surface-muted transition-colors text-left"
    >
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>{dict.theme.system}</span>
      </span>
      <span class="theme-check-icon hidden text-brand-600 font-bold">✓</span>
    </button>
  </div>
</div>

<script define:vars={{ uid, storageKey, labels: dict.theme }}>
  (function() {
    const root = document.getElementById(`theme-toggle-root-${uid}`);
    if (!root) return;

    const btn = document.getElementById(`theme-btn-${uid}`);
    const menu = document.getElementById(`theme-menu-${uid}`);
    const iconLight = root.querySelector('.theme-icon-light');
    const iconDark = root.querySelector('.theme-icon-dark');
    const iconSystem = root.querySelector('.theme-icon-system');
    const labelSpan = root.querySelector('.theme-label');
    const optionBtns = root.querySelectorAll('.theme-option-btn');

    function getCurrentPreference() {
      try {
        const stored = localStorage.getItem(storageKey);
        if (stored === 'light' || stored === 'dark' || stored === 'system') {
          return stored;
        }
      } catch (e) {}
      return 'system';
    }

    function updateUI(preference) {
      // Toggle trigger icons
      if (iconLight) iconLight.classList.toggle('hidden', preference !== 'light');
      if (iconDark) iconDark.classList.toggle('hidden', preference !== 'dark');
      if (iconSystem) iconSystem.classList.toggle('hidden', preference !== 'system');

      // Update trigger label text
      if (labelSpan) {
        if (preference === 'light') labelSpan.textContent = labels.light;
        else if (preference === 'dark') labelSpan.textContent = labels.dark;
        else labelSpan.textContent = labels.system;
      }

      // Update checkmarks in menu
      optionBtns.forEach((optBtn) => {
        const optVal = optBtn.getAttribute('data-theme-value');
        const checkIcon = optBtn.querySelector('.theme-check-icon');
        const isActive = optVal === preference;
        if (checkIcon) {
          checkIcon.classList.toggle('hidden', !isActive);
        }
        if (isActive) {
          optBtn.classList.add('bg-brand-50', 'text-brand-700');
        } else {
          optBtn.classList.remove('bg-brand-50', 'text-brand-700');
        }
      });
    }

    function applyThemeGlobally(preference) {
      try {
        localStorage.setItem(storageKey, preference);
      } catch (e) {}

      const isDark = preference === 'dark' || (preference === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      const docEl = document.documentElement;

      if (isDark) {
        docEl.classList.add('dark');
        docEl.setAttribute('data-theme', 'dark');
      } else {
        docEl.classList.remove('dark');
        docEl.setAttribute('data-theme', 'light');
      }

      docEl.style.colorScheme = isDark ? 'dark' : 'light';

      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) {
        meta.setAttribute('content', isDark ? '#121214' : '#e65100');
      }

      // Notify all instances on page
      window.dispatchEvent(
        new CustomEvent('aheka:theme-changed', {
          detail: { preference, storageKey }
        })
      );
    }

    // Toggle menu dropdown
    function toggleMenu(show) {
      if (!menu || !btn) return;
      const willShow = typeof show === 'boolean' ? show : menu.classList.contains('hidden');
      menu.classList.toggle('hidden', !willShow);
      btn.setAttribute('aria-expanded', willShow ? 'true' : 'false');
    }

    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    // Handle option click
    optionBtns.forEach((optBtn) => {
      optBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const chosen = optBtn.getAttribute('data-theme-value');
        if (chosen) {
          applyThemeGlobally(chosen);
          updateUI(chosen);
          toggleMenu(false);
        }
      });
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target)) {
        toggleMenu(false);
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
        toggleMenu(false);
        btn?.focus();
      }
    });

    // Listen for theme changes from other components or storage
    window.addEventListener('aheka:theme-changed', (e) => {
      if (e.detail && e.detail.storageKey === storageKey) {
        updateUI(e.detail.preference);
      }
    });

    // Listen for OS scheme change if currently in system mode
    if (window.matchMedia) {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      const handleOsChange = () => {
        if (getCurrentPreference() === 'system') {
          applyThemeGlobally('system');
          updateUI('system');
        }
      };
      if (mediaQuery.addEventListener) {
        mediaQuery.addEventListener('change', handleOsChange);
      } else if ('addListener' in mediaQuery) {
        mediaQuery.addListener(handleOsChange);
      }
    }

    // Initialize UI on load
    updateUI(getCurrentPreference());
  })();
</script>
