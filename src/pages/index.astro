---
import { getPreferredLocale, LOCALE_PREFERENCE_COOKIE } from '../lib/i18n';

// A device starts in English. Once a visitor chooses a language, the header stores
// that preference in a first-party cookie and root visits return to it.
return new Response(null, {
  status: 302,
  headers: {
    Location: '/' + getPreferredLocale(Astro.cookies.get(LOCALE_PREFERENCE_COOKIE)?.value),
    'Cache-Control': 'private, no-store',
    Vary: 'Cookie',
  },
});
---
