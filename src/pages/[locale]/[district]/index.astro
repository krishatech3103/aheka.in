---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDictionary, isValidLocale, DEFAULT_LOCALE, type Locale } from '../../../lib/i18n';
import { getDataRepository } from '../../../lib/repositories/dataRepository';

const { locale, district: districtSlug } = Astro.params;
if (!locale || !isValidLocale(locale)) {
  return Astro.redirect(`/${DEFAULT_LOCALE}`, 302);
}

const safeLocale = locale as Locale;
const dict = getDictionary(safeLocale);
const isMr = safeLocale === 'mr';

const repo = getDataRepository();
const district = await repo.getDistrictBySlug(districtSlug || '');

if (!district) {
  return new Response('District not found', { status: 404 });
}

const talukas = await repo.getTalukas(district.id);
const categories = await repo.getCategories();

const districtName = isMr ? district.name_mr : district.name_en;
const pageTitle = isMr
  ? `${districtName} जिल्हा — स्थानिक सेवा आणि कारागीर डिरेक्टरी | Aheka`
  : `${districtName} District — Local Service Providers Directory | Aheka`;

const pageDesc = isMr
  ? `${districtName} जिल्ह्यातील सर्व तालुक्यांमधील इलेक्ट्रिशियन, प्लंबर, सुतार व इतर कारागिरांशी थेट संपर्क साधा.`
  : `Find trusted local service providers across all talukas in ${districtName} district, Maharashtra.`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: dict.directory.breadcrumbsHome,
      item: `https://aheka.in/${safeLocale}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: `${districtName} ${isMr ? 'जिल्हा' : 'District'}`,
      item: `https://aheka.in/${safeLocale}/${district.slug}`,
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  locale={safeLocale}
  canonicalPath={`/${safeLocale}/${district.slug}`}
  schemaJsonLd={breadcrumbSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-ink-muted mb-6" aria-label="Breadcrumb">
      <a href={`/${safeLocale}`} class="hover:text-brand-600 transition-colors">
        {dict.directory.breadcrumbsHome}
      </a>
      <span>/</span>
      <span class="text-ink-primary font-medium">
        {districtName} {isMr ? 'जिल्हा' : 'District'}
      </span>
    </nav>

    <!-- Header Banner -->
    <div class="bg-white rounded-3xl border border-surface-border p-6 sm:p-10 shadow-soft mb-10">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-bold border border-brand-200 mb-3">
          {isMr ? 'महाराष्ट्र राज्य • जिल्हा डिरेक्टरी' : 'Maharashtra State • District Directory'}
        </span>
        <h1 class="text-2xl sm:text-4xl font-black text-ink-primary tracking-tight">
          {districtName} {isMr ? 'जिल्हा' : 'District'}
        </h1>
        <p class="mt-3 text-sm sm:text-base text-ink-secondary leading-relaxed">
          {isMr
            ? `${districtName} जिल्ह्यातील सर्व तालुक्यातील विश्वसनीय स्थानिक सेवा प्रदाते आणि तंत्रज्ञांची संपूर्ण यादी.`
            : `Discover vetted, verified local service providers and tradesmen across all talukas in ${districtName}.`}
        </p>
      </div>
    </div>

    <!-- Talukas Grid -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-ink-primary mb-6 flex items-center gap-2">
        <svg class="w-5 h-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>{isMr ? `${districtName} जिल्ह्यातील तालुके` : `Talukas in ${districtName}`}</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {talukas.map((taluka) => (
          <div class="bg-white rounded-2xl border border-surface-border p-6 shadow-soft hover:shadow-lift transition-all group flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-lg font-bold text-ink-primary group-hover:text-brand-600 transition-colors">
                  {isMr ? taluka.name_mr : taluka.name_en}
                </h3>
                <span class="text-xs px-2.5 py-1 rounded-full bg-surface-muted text-ink-secondary font-medium">
                  {isMr ? 'तालुका' : 'Taluka'}
                </span>
              </div>
              <p class="text-xs text-ink-muted mb-4">
                {isMr
                  ? `${taluka.name_mr} तालुक्यातील स्थानिक कारागीर, कामगार व तंत्रज्ञांशी थेट संपर्क साधा.`
                  : `Browse local service categories available in ${taluka.name_en}.`}
              </p>

              <!-- Quick category pills -->
              <div class="flex flex-wrap gap-1.5 mb-5">
                {categories.slice(0, 4).map((c) => (
                  <a
                    href={`/${safeLocale}/${district.slug}/${taluka.slug}/${c.slug}`}
                    class="text-[11px] px-2 py-1 rounded-md bg-surface-canvas border border-surface-border hover:border-brand-500 text-ink-secondary hover:text-brand-700 transition-colors"
                  >
                    {isMr ? c.name_mr : c.name_en}
                  </a>
                ))}
              </div>
            </div>

            <a
              href={`/${safeLocale}/${district.slug}/${taluka.slug}`}
              class="w-full inline-flex items-center justify-center gap-1.5 bg-brand-50 hover:bg-brand-600 text-brand-700 hover:text-white font-semibold text-xs sm:text-sm py-2.5 rounded-xl border border-brand-200 hover:border-brand-600 transition-colors"
            >
              <span>{isMr ? `${taluka.name_mr} सर्व सेवा पहा` : `View all services in ${taluka.name_en}`}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
