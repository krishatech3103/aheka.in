---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getDictionary, isValidLocale, DEFAULT_LOCALE, type Locale } from '../../../../lib/i18n';
import { getDataRepository } from '../../../../lib/repositories/dataRepository';

const { locale, district: districtSlug, taluka: talukaSlug } = Astro.params;
if (!locale || !isValidLocale(locale)) {
  return Astro.redirect(`/${DEFAULT_LOCALE}`, 302);
}

const safeLocale = locale as Locale;
const dict = getDictionary(safeLocale);
const isMr = safeLocale === 'mr';

const repo = getDataRepository();
const taluka = await repo.getTalukaBySlugs(districtSlug || '', talukaSlug || '');

if (!taluka || !taluka.district) {
  return new Response('Taluka not found', { status: 404 });
}

const categories = await repo.getCategories();
const talukaName = isMr ? taluka.name_mr : taluka.name_en;
const districtName = isMr ? taluka.district.name_mr : taluka.district.name_en;

const pageTitle = isMr
  ? `${talukaName} तालुका — स्थानिक सेवा प्रदाते डिरेक्टरी (${districtName}) | Aheka`
  : `${talukaName} Taluka — Local Services Directory (${districtName}) | Aheka`;

const pageDesc = isMr
  ? `${talukaName} तालुक्यातील सर्व विश्वासू इलेक्ट्रिशियन, प्लंबर, सुतार व स्थानिक कारागिरांशी थेट संपर्क साधा.`
  : `Directly contact trusted local service providers in ${talukaName}, ${districtName} without commission.`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: dict.directory.breadcrumbsHome,
      item: `https://aheka.in/${safeLocale}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: `${districtName} ${isMr ? 'जिल्हा' : 'District'}`,
      item: `https://aheka.in/${safeLocale}/${taluka.district.slug}`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `${talukaName} ${isMr ? 'तालुका' : 'Taluka'}`,
      item: `https://aheka.in/${safeLocale}/${taluka.district.slug}/${taluka.slug}`,
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  locale={safeLocale}
  canonicalPath={`/${safeLocale}/${taluka.district.slug}/${taluka.slug}`}
  currentTalukaName={talukaName}
  currentDistrictSlug={taluka.district.slug}
  currentTalukaSlug={taluka.slug}
  schemaJsonLd={breadcrumbSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-ink-muted mb-6 flex-wrap" aria-label="Breadcrumb">
      <a href={`/${safeLocale}`} class="hover:text-brand-600 transition-colors">
        {dict.directory.breadcrumbsHome}
      </a>
      <span>/</span>
      <a href={`/${safeLocale}/${taluka.district.slug}`} class="hover:text-brand-600 transition-colors">
        {districtName}
      </a>
      <span>/</span>
      <span class="text-ink-primary font-medium">
        {talukaName} {isMr ? 'तालुका' : 'Taluka'}
      </span>
    </nav>

    <!-- Header Banner -->
    <div class="bg-white rounded-3xl border border-surface-border p-6 sm:p-10 shadow-soft mb-10">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-bold border border-brand-200 mb-3">
          <span class="w-2 h-2 rounded-full bg-brand-500"></span>
          <span>{districtName} {isMr ? 'जिल्हा' : 'District'}</span>
        </span>
        <h1 class="text-2xl sm:text-4xl font-black text-ink-primary tracking-tight">
          {talukaName} {isMr ? 'तालुक्यातील स्थानिक सेवा' : 'Local Services in Taluka'}
        </h1>
        <p class="mt-3 text-sm sm:text-base text-ink-secondary leading-relaxed">
          {isMr
            ? `${talukaName} तालुक्यातील घरगुती आणि व्यावसायिक कामांसाठी आवश्यक कारागीर आणि तंत्रज्ञांची वर्गवारी.`
            : `Select a service category to discover vetted providers available in ${talukaName}.`}
        </p>
      </div>
    </div>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((cat) => (
        <a
          href={`/${safeLocale}/${taluka.district!.slug}/${taluka.slug}/${cat.slug}`}
          class="bg-white rounded-2xl border border-surface-border p-6 shadow-soft hover:shadow-lift hover:border-brand-500 transition-all group flex flex-col justify-between"
        >
          <div>
            <div class="w-12 h-12 rounded-xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 group-hover:scale-105 transition-transform mb-4">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h2 class="text-lg font-bold text-ink-primary group-hover:text-brand-600 transition-colors">
              {isMr ? cat.name_mr : cat.name_en}
            </h2>
            <p class="text-xs sm:text-sm text-ink-secondary mt-2 leading-relaxed line-clamp-2">
              {isMr ? (cat.description_mr || cat.description_en) : (cat.description_en || cat.description_mr)}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-surface-border flex items-center justify-between text-xs font-semibold text-brand-700">
            <span>{isMr ? 'सेवा प्रदाते पहा' : 'View Providers'}</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    <!-- Taluka Provider CTA Banner -->
    <div class="mt-16 bg-gradient-to-r from-brand-600 to-brand-700 rounded-3xl p-8 sm:p-10 text-white shadow-lift flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-xl sm:text-2xl font-bold">
          {isMr ? `तुम्ही ${talukaName} तालुक्यातील सेवा प्रदाता आहात का?` : `Are you a service provider in ${talukaName}?`}
        </h3>
        <p class="text-xs sm:text-sm text-brand-100 mt-2 max-w-xl">
          {isMr
            ? `Aheka वर फक्त ₹९९९/वार्षिक वर्गणीत नोंदणी करा. तालुक्यातील ग्राहकांकडून थेट कॉल आणि व्हॉट्सॲप मेसेज मिळवा.`
            : `Get discovered by local customers in ${talukaName} for just ₹999/year. Receive direct calls and WhatsApp inquiries.`}
        </p>
      </div>
      <a
        href={`/${safeLocale}/join`}
        class="bg-white hover:bg-brand-50 text-brand-900 font-bold text-sm px-6 py-3 rounded-xl transition-all shadow-md whitespace-nowrap flex-shrink-0"
      >
        {dict.nav.join}
      </a>
    </div>

  </div>
</BaseLayout>
