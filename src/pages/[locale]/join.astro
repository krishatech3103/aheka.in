---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary, isValidLocale, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { getDataRepository } from '../../lib/repositories/dataRepository';
import { getRuntimeConfig } from '../../lib/runtime/config';

const { locale } = Astro.params;
if (!locale || !isValidLocale(locale)) {
  return Astro.redirect(`/${DEFAULT_LOCALE}`, 302);
}

const safeLocale = locale as Locale;
const dict = getDictionary(safeLocale);
const isMr = safeLocale === 'mr';

const repo = getDataRepository();
const districts = await repo.getDistricts();
const talukas = await repo.getTalukas();
const categories = await repo.getCategories();
const turnstileSiteKey = getRuntimeConfig('PUBLIC_TURNSTILE_SITE_KEY');

const pageTitle = isMr
  ? 'आहे का? वर नोंदणी करा — स्थानिक सेवा प्रदात्यांसाठी | ₹९९९/वर्ष'
  : 'Join Aheka — Register as a Local Service Provider | ₹999/year';

const pageDesc = isMr
  ? 'तुमच्या तालुक्यातील ग्राहकांशी थेट जोडा. फक्त ₹९९९ वार्षिक वर्गणी, कोणतेही कमिशन नाही. आजच नोंदणी करा.'
  : 'List your business on Aheka. Get direct calls and WhatsApp leads in your taluka with zero commission. Flat ₹999/year.';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  locale={safeLocale}
  canonicalPath={`/${safeLocale}/join`}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-14">
    
    <!-- Hero Header -->
    <div class="text-center mb-10">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-bold border border-brand-200 mb-3">
        <span class="w-2 h-2 rounded-full bg-brand-500"></span>
        <span>{isMr ? 'स्थानिक कारागीर नोंदणी' : 'Service Provider Onboarding'}</span>
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-ink-primary tracking-tight">
        {dict.join.title}
      </h1>
      <p class="mt-3 text-sm sm:text-base text-ink-secondary max-w-xl mx-auto leading-relaxed">
        {dict.join.subtitle}
      </p>

      <!-- Key Value Propositions -->
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-3 text-left">
        <div class="bg-white p-3.5 rounded-xl border border-surface-border text-center shadow-2xs">
          <div class="text-lg font-bold text-brand-600">{isMr ? '₹९९९ / वर्ष' : '₹999 / year'}</div>
          <div class="text-xs text-ink-muted mt-0.5">{isMr ? 'कमीशन नाही, फिक्स फी' : 'Zero commission'}</div>
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-surface-border text-center shadow-2xs">
          <div class="text-lg font-bold text-brand-600">{isMr ? '१० जागा मर्यादा' : '10-slot limit'}</div>
          <div class="text-xs text-ink-muted mt-0.5">{isMr ? 'वाजवी दृश्यमानता' : 'Fair 10 slots per service'}</div>
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-surface-border text-center shadow-2xs">
          <div class="text-lg font-bold text-brand-600">{isMr ? 'थेट ग्राहक संपर्क' : 'Direct customer contact'}</div>
          <div class="text-xs text-ink-muted mt-0.5">{isMr ? 'थेट कॉल व व्हॉट्सॲप' : 'Direct Call & WhatsApp'}</div>
        </div>
      </div>
    </div>

    <!-- Application Form Card -->
    <div class="bg-white rounded-3xl border border-surface-border p-6 sm:p-10 shadow-soft">
      <form id="join-form" class="space-y-6">
        
        <!-- Honeypot field (hidden from real users) -->
        <div class="hidden" aria-hidden="true">
          <label for="website_honeypot">Leave blank</label>
          <input type="text" id="website_honeypot" name="website_honeypot" tabindex="-1" autocomplete="off" />
        </div>

        <!-- 1. Full Name -->
        <div>
          <label for="provider_name" class="block text-xs font-bold uppercase tracking-wider text-ink-primary mb-1.5">
            {dict.join.providerName} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="provider_name"
            name="provider_name"
            required
            minlength="2"
            maxlength="100"
            placeholder={isMr ? 'उदा. राहुल रमेश पाटील' : 'e.g. Rahul Ramesh Patil'}
            class="w-full px-4 py-3 rounded-xl border border-surface-border bg-surface-canvas focus:bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm transition-all"
          />
        </div>

        <!-- 2. Business / Shop Name -->
        <div>
          <label for="business_name" class="block text-xs font-bold uppercase tracking-wider text-ink-primary mb-1.5">
            {dict.join.businessName} <span class="text-ink-muted text-xs normal-case">({isMr ? 'पर्यायी' : 'optional'})</span>
          </label>
          <input
            type="text"
            id="business_name"
            name="business_name"
            maxlength="150"
            placeholder={isMr ? 'उदा. राहुल इलेक्ट्रिकल सर्व्हिसेस' : 'e.g. Rahul Electrical Works'}
            class="w-full px-4 py-3 rounded-xl border border-surface-border bg-surface-canvas focus:bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm transition-all"
          />
        </div>

        <!-- 3. Phone & WhatsApp in 2 Cols -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="mobile" class="block text-xs font-bold uppercase tracking-wider text-ink-primary mb-1.5">
              {dict.join.mobile} <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute left-3.5 top-3.5 text-ink-muted font-medium text-sm">+91</span>
              <input
                type="tel"
                id="mobile"
                name="mobile"
                required
                pattern="[6-9][0-9]{9}"
                placeholder="9822011101"
                class="w-full pl-12 pr-4 py-3 rounded-xl border border-surface-border bg-surface-canvas focus:bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm transition-all font-mono"
              />
            </div>
            <p class="text-[11px] text-ink-muted mt-1">{isMr ? '१० अंकी चालू मोबाईल क्रमांक' : '10-digit calling number'}</p>
          </div>

          <div>
            <label for="whatsapp_number" class="block text-xs font-bold uppercase tracking-wider text-ink-primary mb-1.5">
              {dict.join.whatsapp} <span class="text-ink-muted text-xs normal-case">({isMr ? 'पर्यायी' : 'optional'})</span>
            </label>
            <div class="relative">
              <span class="absolute left-3.5 top-3.5 text-ink-muted font-medium text-sm">+91</span>
              <input
                type="tel"
                id="whatsapp_number"
                name="whatsapp_number"
                pattern="[6-9][0-9]{9}"
                placeholder="9822011101"
                class="w-full pl-12 pr-4 py-3 rounded-xl border border-surface-border bg-surface-canvas focus:bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm transition-all font-mono"
              />
            </div>
            <p class="text-[11px] text-ink-muted mt-1">{isMr ? 'कॉल नंबरपेक्षा वेगळा असल्यास टाका' : 'Leave blank if same as mobile'}</p>
          </div>
        </div>

        <!-- 4. District & Taluka Cascading Selectors -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="district_id" class="block text-xs font-bold uppercase tracking-wider text-ink-primary mb-1.5">
              {dict.join.district} <span class="text-red-500">*</span>
            </label>
            <select
              id="district_id"
              name="district_id"
              required
              class="w-full px-4 py-3 rounded-xl border border-surface-border bg-surface-canvas focus:bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm transition-all"
            >
              <option value="">{isMr ? '-- जिल्हा निवडा --' : '-- Select District --'}</option>
              {districts.map((d) => (
                <option value={d.id}>{isMr ? d.name_mr : d.name_en}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="taluka_id" class="block text-xs font-bold uppercase tracking-wider text-ink-primary mb-1.5">
              {dict.join.taluka} <span class="text-red-500">*</span>
            </label>
            <select
              id="taluka_id"
              name="taluka_id"
              required
              disabled
              class="w-full px-4 py-3 rounded-xl border border-surface-border bg-surface-canvas focus:bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm transition-all disabled:opacity-50"
            >
              <option value="">{isMr ? '-- आधी जिल्हा निवडा --' : '-- Select District First --'}</option>
            </select>
          </div>
        </div>

        <!-- 5. Service Categories Checkboxes -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-ink-primary mb-2">
            {dict.join.categories} <span class="text-red-500">*</span>
            <span class="text-ink-muted font-normal normal-case ml-1">({isMr ? 'किमान १ निवडा' : 'select at least 1'})</span>
          </label>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
            {categories.map((c) => (
              <label class="flex items-center gap-2 p-3 rounded-xl border border-surface-border hover:border-brand-500 bg-surface-canvas hover:bg-white cursor-pointer transition-all text-xs sm:text-sm font-medium">
                <input
                  type="checkbox"
                  name="category_ids"
                  value={c.id}
                  class="rounded text-brand-600 focus:ring-brand-500 w-4 h-4"
                />
                <span class="text-ink-primary">{isMr ? c.name_mr : c.name_en}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- 6. Experience in Years -->
        <div>
          <label for="experience_years" class="block text-xs font-bold uppercase tracking-wider text-ink-primary mb-1.5">
            {dict.join.experienceYears} <span class="text-red-500">*</span>
          </label>
          <input
            type="number"
            id="experience_years"
            name="experience_years"
            required
            min="0"
            max="60"
            placeholder="5"
            class="w-full sm:w-1/3 px-4 py-3 rounded-xl border border-surface-border bg-surface-canvas focus:bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm transition-all font-mono"
          />
        </div>

        <!-- 7. Full Address -->
        <div>
          <label for="full_address" class="block text-xs font-bold uppercase tracking-wider text-ink-primary mb-1.5">
            {dict.join.address} <span class="text-red-500">*</span>
          </label>
          <textarea
            id="full_address"
            name="full_address"
            required
            rows="2"
            placeholder={isMr ? 'उदा. दुकान क्र. ४, नेहरू चौक, संगमनेर' : 'e.g. Shop No. 4, Nehru Chowk, Sangamner'}
            class="w-full px-4 py-3 rounded-xl border border-surface-border bg-surface-canvas focus:bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm transition-all"
          ></textarea>
        </div>

        <!-- 8. Service Areas Text -->
        <div>
          <label for="service_areas_text" class="block text-xs font-bold uppercase tracking-wider text-ink-primary mb-1.5">
            {dict.join.serviceAreas} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="service_areas_text"
            name="service_areas_text"
            required
            placeholder={isMr ? 'उदा. संगमनेर शहर, घुलेवाडी, धांदरफळ, जोर्वे' : 'e.g. Sangamner city, Ghulewadi, Dhandarphal, Jorve'}
            class="w-full px-4 py-3 rounded-xl border border-surface-border bg-surface-canvas focus:bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm transition-all"
          />
          <p class="text-[11px] text-ink-muted mt-1">{isMr ? 'तुम्ही ज्या गावांमध्ये किंवा परिसरात सेवा देता ती नावे टाका' : 'Villages and areas in the taluka where you provide services'}</p>
        </div>

        <!-- 9. Google Maps Link (Optional) -->
        <div>
          <label for="google_maps_url" class="block text-xs font-bold uppercase tracking-wider text-ink-primary mb-1.5">
            {dict.join.mapsUrl} <span class="text-ink-muted text-xs normal-case">({isMr ? 'पर्यायी' : 'optional'})</span>
          </label>
          <input
            type="url"
            id="google_maps_url"
            name="google_maps_url"
            placeholder="https://maps.app.goo.gl/..."
            class="w-full px-4 py-3 rounded-xl border border-surface-border bg-surface-canvas focus:bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm transition-all"
          />
        </div>

        <!-- 10. Single Profile Photo Upload (Policy: Exactly one optional photo) -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-ink-primary mb-1.5">
            {dict.join.profileImage} <span class="text-ink-muted text-xs normal-case">({isMr ? 'पर्यायी' : 'optional'})</span>
          </label>
          <div class="border-2 border-dashed border-surface-border hover:border-brand-500 rounded-2xl p-4 text-center bg-surface-canvas transition-colors">
            <input
              type="file"
              id="photo_upload"
              accept="image/jpeg,image/png,image/webp"
              class="hidden"
            />
            <button
              type="button"
              onclick="document.getElementById('photo_upload')?.click()"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white border border-surface-border text-xs font-semibold text-ink-primary hover:bg-surface-muted transition-colors shadow-2xs"
            >
              <svg class="w-4 h-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>{isMr ? 'फोटो निवडा (कमाल १ फोटो)' : 'Choose Photo (Single image max)'}</span>
            </button>
            <p id="upload-status" class="text-xs text-ink-muted mt-2">
              {isMr ? 'जेपीजी, पीएनजी किंवा वेबपी (कमाल ५ एमबी). आपोआप कॉम्प्रेस केला जाईल.' : 'JPG, PNG or WebP. Automatically optimized.'}
            </p>
          </div>
        </div>

        <!-- 11. Consent & Terms Declaration -->
        <div class="pt-2">
          <label class="flex items-start gap-3 cursor-pointer">
            <input
              type="checkbox"
              id="consent_agreed"
              name="consent_agreed"
              required
              class="mt-1 rounded text-brand-600 focus:ring-brand-500 w-4 h-4"
            />
            <span class="text-xs text-ink-secondary leading-relaxed">
              {dict.join.consent}{' '}
              <a href={`/${safeLocale}/provider-terms`} target="_blank" class="text-brand-700 underline font-semibold">
                {dict.nav.providerTerms}
              </a>
            </span>
          </label>
        </div>

        {turnstileSiteKey && (
          <div class="flex justify-center" aria-label="Spam protection">
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
          </div>
        )}

        <!-- Error Alert Container -->
        <div id="form-error" class="hidden p-4 rounded-xl bg-red-50 border border-red-200 text-xs text-red-700 font-medium"></div>

        <!-- Submit Button -->
        <button
          type="submit"
          id="submit-btn"
          class="w-full flex items-center justify-center gap-2 bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-bold text-sm sm:text-base py-4 rounded-2xl shadow-lift transition-all"
        >
          <span>{dict.join.submitButton}</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>

      </form>
    </div>

    <!-- Success Modal Dialog -->
    <dialog
      id="success-dialog"
      class="m-auto rounded-3xl p-0 shadow-2xl border border-surface-border bg-white max-w-md w-[92vw] backdrop:bg-ink-primary/50 backdrop:backdrop-blur-xs"
    >
      <div class="p-6 sm:p-8 text-center">
        <div class="w-16 h-16 rounded-2xl bg-green-50 text-green-600 border border-green-200 flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h3 class="text-xl font-black text-ink-primary">
          {dict.join.successTitle}
        </h3>
        <p class="text-xs sm:text-sm text-ink-secondary mt-2 leading-relaxed">
          {dict.join.successDesc}
        </p>
        <div class="my-4 p-3 bg-surface-canvas rounded-xl border border-surface-border text-xs text-ink-muted font-mono">
          {isMr ? 'अर्जाचा क्रमांक' : 'Application ID'}: <span id="app-id-display" class="font-bold text-ink-primary"></span>
        </div>
        <a
          href={`/${safeLocale}`}
          class="w-full inline-flex items-center justify-center bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm py-3 rounded-xl transition-colors"
        >
          {isMr ? 'मुख्य पानावर जा' : 'Return to Homepage'}
        </a>
      </div>
    </dialog>

  </div>
</BaseLayout>

{turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script is:inline define:vars={{ talukas, isMr }}>
  // Cascading District -> Taluka dropdown logic
  const districtSelect = document.getElementById('district_id');
  const talukaSelect = document.getElementById('taluka_id');

  districtSelect?.addEventListener('change', (e) => {
    const districtId = e.target.value;
    talukaSelect.innerHTML = `<option value="">${isMr ? '-- तालुका निवडा --' : '-- Select Taluka --'}</option>`;
    
    if (!districtId) {
      talukaSelect.disabled = true;
      return;
    }

    const filtered = talukas.filter(t => t.district_id === districtId);
    filtered.forEach(t => {
      const opt = document.createElement('option');
      opt.value = t.id;
      opt.textContent = isMr ? t.name_mr : t.name_en;
      talukaSelect.appendChild(opt);
    });

    talukaSelect.disabled = false;
  });

  // Client-side image handling (Single image policy)
  let uploadedImageBase64 = null;
  const photoInput = document.getElementById('photo_upload');
  const uploadStatus = document.getElementById('upload-status');

  photoInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    if (file.size > 5 * 1024 * 1024) {
      alert(isMr ? 'फोटो ५ एमबी पेक्षा लहान असावा.' : 'Image must be less than 5MB.');
      return;
    }

    uploadStatus.textContent = isMr ? 'फोटो तयार करत आहे...' : 'Processing image...';

    const reader = new FileReader();
    reader.onload = (event) => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const MAX_WIDTH = 800;
        const MAX_HEIGHT = 800;
        let width = img.width;
        let height = img.height;

        if (width > height) {
          if (width > MAX_WIDTH) {
            height *= MAX_WIDTH / width;
            width = MAX_WIDTH;
          }
        } else {
          if (height > MAX_HEIGHT) {
            width *= MAX_HEIGHT / height;
            height = MAX_HEIGHT;
          }
        }

        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, width, height);

        uploadedImageBase64 = canvas.toDataURL('image/webp', 0.85);
        uploadStatus.textContent = isMr ? '✓ फोटो निवडला गेला.' : '✓ Photo selected and compressed.';
        uploadStatus.classList.add('text-green-600', 'font-semibold');
      };
      img.src = event.target.result;
    };
    reader.readAsDataURL(file);
  });

  // Form submission handling
  const form = document.getElementById('join-form');
  const submitBtn = document.getElementById('submit-btn');
  const errorBox = document.getElementById('form-error');
  const successDialog = document.getElementById('success-dialog');
  const appIdDisplay = document.getElementById('app-id-display');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');
    errorBox.textContent = '';

    const formData = new FormData(form);
    const categoryIds = formData.getAll('category_ids');

    if (categoryIds.length === 0) {
      errorBox.textContent = isMr ? 'कृपया किमान १ सेवा प्रकार निवडा.' : 'Please select at least 1 service category.';
      errorBox.classList.remove('hidden');
      return;
    }

    const payload = {
      provider_name: formData.get('provider_name'),
      business_name: formData.get('business_name') || null,
      mobile: formData.get('mobile'),
      whatsapp_number: formData.get('whatsapp_number') || null,
      district_id: formData.get('district_id'),
      taluka_id: formData.get('taluka_id'),
      category_ids: categoryIds,
      experience_years: Number(formData.get('experience_years') || 0),
      full_address: formData.get('full_address'),
      service_areas_text: formData.get('service_areas_text'),
      google_maps_url: formData.get('google_maps_url') || null,
      image_path: uploadedImageBase64 || null,
      turnstile_token: document.querySelector('[name="cf-turnstile-response"]')?.value || null,
      consent_agreed: formData.get('consent_agreed') === 'on',
      website_honeypot: formData.get('website_honeypot') || null,
      locale: isMr ? 'mr' : 'en',
    };

    submitBtn.disabled = true;
    submitBtn.textContent = isMr ? 'नोंदणी करत आहे...' : 'Submitting application...';

    try {
      const res = await fetch('/api/application/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        const errorMsg = data.errors ? Object.values(data.errors).flat().join(', ') : (data.error || 'Submission failed');
        errorBox.textContent = errorMsg;
        errorBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = isMr ? 'नोंदणी सबमिट करा' : 'Submit Application';
        return;
      }

      // Success
      if (appIdDisplay) appIdDisplay.textContent = data.id;
      successDialog?.showModal();
      form.reset();
    } catch (err) {
      errorBox.textContent = isMr ? 'नेटवर्क त्रुटी. कृपया पुन्हा प्रयत्न करा.' : 'Network error. Please try again.';
      errorBox.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = isMr ? 'नोंदणी सबमिट करा' : 'Submit Application';
    }
  });
</script>
