---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchIsland from '../../components/SearchIsland';
import { getDictionary, isValidLocale, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { getDataRepository } from '../../lib/repositories/dataRepository';

const { locale } = Astro.params;
if (!locale || !isValidLocale(locale)) {
  return Astro.redirect(`/${DEFAULT_LOCALE}`, 302);
}

const safeLocale = locale as Locale;
const dict = getDictionary(safeLocale);
const isMr = safeLocale === 'mr';

const repo = getDataRepository();
const [districts, talukas, categories] = await Promise.all([
  repo.getDistricts(),
  repo.getTalukas(),
  repo.getCategories(),
]);

// Format categories for SearchIsland
const searchCategories = categories.map(c => ({
  slug: c.slug,
  name_en: c.name_en,
  name_mr: c.name_mr,
  icon_key: c.icon_key,
  aliases: c.aliases || [],
}));

// Popular Categories (prefer featured categories, fallback to sort order)
const popularCategories = [...categories].sort((a, b) => {
  if (a.is_featured && !b.is_featured) return -1;
  if (!a.is_featured && b.is_featured) return 1;
  return (a.sort_order ?? 0) - (b.sort_order ?? 0);
});

// All searchable talukas with district metadata
const searchTalukas = talukas.map(t => {
  const d = districts.find(dist => dist.id === t.district_id);
  return {
    slug: t.slug,
    name_en: t.name_en,
    name_mr: t.name_mr,
    district_slug: d?.slug || '',
    district_name_en: d?.name_en || '',
    district_name_mr: d?.name_mr || '',
    center_latitude: t.center_latitude,
    center_longitude: t.center_longitude,
    location_detection_radius_km: t.location_detection_radius_km,
  };
});

const pageTitle = isMr
  ? 'आहे का? — महाराष्ट्रातील स्थानिक सेवा शोध'
  : 'Aheka — Hyperlocal Service Discovery for Maharashtra';

const pageDesc = isMr
  ? 'तुमच्या तालुक्यातील स्थानिक सेवा देणाऱ्यांशी थेट संपर्क करा. इलेक्ट्रिशियन, प्लंबर, सुतार व इतर सेवा — कोणतेही कमिशन नाही.'
  : 'Find trusted local service providers near you. Search by taluka and contact electricians, plumbers and professionals directly.';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  locale={safeLocale}
  navigationData={{ districts, talukas, categories }}
  canonicalPath={`/${safeLocale}`}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-surface-canvas pt-12 pb-16 dark:bg-ink-canvas sm:pt-20 sm:pb-28">
    <!-- Subtle Background Radial Glow -->
    <div class="absolute inset-0 -z-10 flex items-center justify-center opacity-35 dark:opacity-20 pointer-events-none">
      <div class="w-[450px] h-[450px] bg-gradient-to-tr from-brand-300 via-amber-200 to-transparent dark:from-brand-900 dark:via-amber-950 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Tag Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-950/60 border border-brand-200 dark:border-brand-800/80 text-brand-700 dark:text-brand-300 text-xs sm:text-sm font-semibold mb-4 sm:mb-6 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
        <span>{dict.home.badge}</span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-ink-primary tracking-tight leading-tight max-w-4xl mx-auto text-balance">
        {dict.home.heroHeading}
      </h1>

      <!-- Compact Subheading -->
      <p class="mt-3 sm:mt-5 text-sm sm:text-base md:text-lg text-ink-secondary max-w-2xl mx-auto leading-relaxed text-balance">
        {dict.home.heroSubheading}
      </p>

      <!-- Search Island Interactive Component -->
      <div class="mt-9 sm:mt-12">
        <SearchIsland
          client:load
          locale={safeLocale}
          categories={searchCategories}
          talukas={searchTalukas}
        />
      </div>
    </div>
  </section>

  <!-- Popular Categories Grid (Above the fold / Just below hero) -->
  <section
    id="popular-services-by-location"
    data-talukas={JSON.stringify(searchTalukas)}
    data-locale={safeLocale}
    class="py-10 sm:py-14 bg-white dark:bg-ink-surface border-y border-surface-border"
    hidden
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-6 sm:mb-8">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-ink-primary">
            {dict.home.popularServices}
          </h2>
          <p class="text-xs sm:text-sm text-ink-muted mt-0.5">
            {dict.home.popularServicesDesc}
          </p>
        </div>
        <a
          data-view-all-services
          href={`/${safeLocale}/services`}
          class="text-xs sm:text-sm font-bold text-brand-600 dark:text-brand-400 hover:text-brand-700 hover:underline flex items-center gap-1"
        >
          <span>{dict.home.viewAllServices}</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Category Cards Grid or Empty State -->
      {popularCategories.length === 0 ? (
        <div class="py-12 text-center text-ink-muted bg-surface-canvas/40 dark:bg-ink-canvas/20 rounded-2xl border border-surface-border">
          <p class="text-base font-semibold">
            {isMr ? 'स्थानिक सेवा जोडण्याचे काम सुरू आहे. लवकरच उपलब्ध होतील.' : 'Services are currently being added for this location. Please check back soon.'}
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
          {popularCategories.slice(0, 12).map((cat) => (
              <a
                data-category-card
                data-category-slug={cat.slug}
                href={`/${safeLocale}/services`}
                class="flex flex-col items-center text-center p-4 sm:p-5 rounded-2xl border border-surface-border bg-surface-canvas/60 dark:bg-ink-canvas/40 hover:bg-white dark:hover:bg-ink-surface hover:border-brand-500 hover:shadow-soft transition-all duration-200 group"
              >
                <!-- Category Icon Container with semantic SVG -->
                <div class="w-12 h-12 rounded-xl bg-brand-50 dark:bg-brand-950/60 border border-brand-100 dark:border-brand-900/60 flex items-center justify-center text-brand-600 dark:text-brand-400 group-hover:scale-110 transition-transform duration-200 mb-3 shadow-2xs">
                  {cat.icon_key === 'zap' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  )}
                  {cat.icon_key === 'droplet' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z" />
                    </svg>
                  )}
                  {cat.icon_key === 'hammer' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z" />
                    </svg>
                  )}
                  {cat.icon_key === 'paint-bucket' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                  )}
                  {cat.icon_key === 'tv' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <rect x="2" y="7" width="20" height="14" rx="2" stroke-width="2" />
                      <polyline points="17 2 12 7 7 2" stroke-width="2" />
                    </svg>
                  )}
                  {cat.icon_key === 'home' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                  )}
                  {!['zap', 'droplet', 'hammer', 'paint-bucket', 'tv', 'home'].includes(cat.icon_key) && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  )}
                </div>

                <h3 class="font-bold text-xs sm:text-sm text-ink-primary group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                  {isMr ? cat.name_mr : cat.name_en}
                </h3>
                <span data-category-taluka class="text-[11px] text-ink-muted mt-1 font-medium notranslate" translate="no"></span>
              </a>
          ))}
        </div>
      )}
  </section>

  <script>
    import { LOCATION_PREFERENCE_EVENT, readLocationPreference, type LocationPreference } from '../../lib/location/preference';

    type HomepageTaluka = {
      slug: string;
      name_en: string;
      name_mr: string;
      district_slug: string;
    };

    function updatePopularServices(preference: LocationPreference | null = readLocationPreference()) {
      const section = document.getElementById('popular-services-by-location');
      if (!section) return;

      const talukas = JSON.parse(section.dataset.talukas || '[]') as HomepageTaluka[];
      const selectedTaluka = preference && talukas.find((taluka) => (
        taluka.district_slug === preference.districtSlug && taluka.slug === preference.talukaSlug
      ));

      section.hidden = !selectedTaluka;
      if (!selectedTaluka || !preference) return;

      const locale = section.dataset.locale || 'en';
      const talukaName = locale === 'mr' ? selectedTaluka.name_mr : selectedTaluka.name_en;
      const directoryPath = `/${locale}/${preference.districtSlug}/${preference.talukaSlug}`;

      const viewAll = section.querySelector<HTMLAnchorElement>('[data-view-all-services]');
      if (viewAll) viewAll.href = directoryPath;

      section.querySelectorAll<HTMLAnchorElement>('[data-category-card]').forEach((card) => {
        const categorySlug = card.dataset.categorySlug;
        if (categorySlug) card.href = `${directoryPath}/${categorySlug}`;
      });
      section.querySelectorAll<HTMLElement>('[data-category-taluka]').forEach((label) => {
        label.textContent = talukaName;
      });
    }

    updatePopularServices();
    document.addEventListener('astro:page-load', () => updatePopularServices());
    window.addEventListener(LOCATION_PREFERENCE_EVENT, (event) => {
      updatePopularServices((event as CustomEvent<LocationPreference>).detail || null);
    });
  </script>

  <!-- How It Works Section -->
  <section class="py-14 sm:py-20 bg-surface-canvas dark:bg-ink-canvas">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
        <h2 class="text-2xl sm:text-4xl font-extrabold text-ink-primary">
          {dict.home.howItWorksTitle}
        </h2>
        <p class="text-sm sm:text-base text-ink-secondary mt-2">
          {dict.home.howItWorksSub}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        <!-- Step 1 -->
        <div class="bg-white dark:bg-ink-surface rounded-2xl border border-surface-border p-6 shadow-soft text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-black text-xl flex items-center justify-center mx-auto mb-4 shadow-sm">
            {isMr ? '१' : '1'}
          </div>
          <h3 class="text-base sm:text-lg font-bold text-ink-primary mb-2">
            {dict.home.step1Title}
          </h3>
          <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed">
            {dict.home.step1Desc}
          </p>
        </div>

        <!-- Step 2 -->
        <div class="bg-white dark:bg-ink-surface rounded-2xl border border-surface-border p-6 shadow-soft text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-black text-xl flex items-center justify-center mx-auto mb-4 shadow-sm">
            {isMr ? '२' : '2'}
          </div>
          <h3 class="text-base sm:text-lg font-bold text-ink-primary mb-2">
            {dict.home.step2Title}
          </h3>
          <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed">
            {dict.home.step2Desc}
          </p>
        </div>

        <!-- Step 3 -->
        <div class="bg-white dark:bg-ink-surface rounded-2xl border border-surface-border p-6 shadow-soft text-center">
          <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-black text-xl flex items-center justify-center mx-auto mb-4 shadow-sm">
            {isMr ? '३' : '3'}
          </div>
          <h3 class="text-base sm:text-lg font-bold text-ink-primary mb-2">
            {dict.home.step3Title}
          </h3>
          <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed">
            {dict.home.step3Desc}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Provider Registration CTA Section -->
  <section class="py-14 sm:py-18 bg-gradient-to-br from-brand-900 via-brand-800 to-ink-canvas text-white relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <span class="inline-block px-3 py-1 rounded-full bg-white/10 text-brand-200 text-xs font-semibold mb-3 backdrop-blur-xs border border-white/10">
        {dict.home.joinSectionBadge}
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight">
        {dict.home.joinSectionTitle}
      </h2>
      <p class="mt-3 text-sm sm:text-base text-brand-100 max-w-2xl mx-auto leading-relaxed">
        {dict.home.joinSectionDesc}
      </p>

      <div class="mt-7 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={`/${safeLocale}/join`}
          class="w-full sm:w-auto inline-flex items-center justify-center bg-white hover:bg-brand-50 active:bg-brand-100 text-brand-900 font-bold text-sm sm:text-base px-6 py-3.5 rounded-xl shadow-lg transition-all transform hover:-translate-y-0.5"
        >
          {dict.home.joinCtaButton} ({isMr ? '₹९९९/वर्ष' : '₹999/yr'})
        </a>
        <a
          href={`/${safeLocale}/provider-terms`}
          class="text-xs sm:text-sm text-brand-200 hover:text-white underline underline-offset-4 py-2"
        >
          {dict.nav.providerTerms} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
