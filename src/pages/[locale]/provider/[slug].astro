---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShareButton from '../../../components/ShareButton';
import { getDictionary, getLocalizedText, isValidLocale, DEFAULT_LOCALE, type Locale } from '../../../lib/i18n';
import { getDataRepository } from '../../../lib/repositories/dataRepository';
import { getSiteUrl } from '../../../lib/runtime/config';

const { locale, slug } = Astro.params;
if (!locale || !isValidLocale(locale)) {
  return Astro.redirect(`/${DEFAULT_LOCALE}`, 302);
}

const safeLocale = locale as Locale;
const dict = getDictionary(safeLocale);
const isMr = safeLocale === 'mr';
const siteUrl = getSiteUrl(Astro.url.origin);

const repo = getDataRepository();
const profile = await repo.getProviderBySlug(slug || '');

if (!profile) {
  return new Response('Provider not found', { status: 404 });
}

const { vendor, listings, serviceAreas, isEligible } = profile;

// If provider subscription has expired or is not active, return 404
if (!isEligible) {
  return new Response('Listing inactive or expired', { status: 404 });
}

const primaryListing = listings[0];
let districtSlug = primaryListing?.taluka.district?.slug;
if (!districtSlug && primaryListing?.taluka.district_id) {
  const allDistricts = await repo.getDistricts();
  const foundDistrict = allDistricts.find(d => d.id === primaryListing.taluka.district_id);
  districtSlug = foundDistrict?.slug;
}

const talukaName = primaryListing ? (isMr ? primaryListing.taluka.name_mr : primaryListing.taluka.name_en) : '';
const districtName = primaryListing && primaryListing.taluka.district ? (isMr ? primaryListing.taluka.district.name_mr : primaryListing.taluka.district.name_en) : '';
const primaryCategoryName = primaryListing ? (isMr ? primaryListing.category.name_mr : primaryListing.category.name_en) : '';
const localizedDescription = getLocalizedText(safeLocale, vendor.description_en, vendor.description_mr);
const localizedServiceAreas = serviceAreas
  .map((area) => getLocalizedText(safeLocale, area.name_en, area.name_mr))
  .filter(Boolean);

const pageTitle = isMr
  ? `${vendor.provider_name} ${vendor.business_name ? `(${vendor.business_name})` : ''} — ${talukaName} मधील ${primaryCategoryName} | आहे का?`
  : `${vendor.provider_name} ${vendor.business_name ? `(${vendor.business_name})` : ''} — ${primaryCategoryName} in ${talukaName} | Aheka`;
const pageDesc = isMr
  ? `${vendor.provider_name}, ${talukaName} मधील विश्वासू ${primaryCategoryName}. थेट कॉल करा: ${vendor.mobile} किंवा व्हॉट्सॲपवर संपर्क साधा.`
  : `Contact ${vendor.provider_name} (${vendor.business_name || primaryCategoryName}) in ${talukaName}, Maharashtra. Direct mobile: ${vendor.mobile}.`;
const shareText = isMr
  ? `${dict.actions.sharePrompt} ${vendor.provider_name} (${primaryCategoryName}), ${talukaName} येथे.`
  : `${dict.actions.sharePrompt} ${vendor.provider_name} (${primaryCategoryName}) in ${talukaName}.`;

const currentUrl = `${siteUrl}/${safeLocale}/provider/${vendor.slug}`;

// WhatsApp link with friendly prefilled message
const waText = encodeURIComponent(
  isMr
    ? `नमस्कार ${vendor.provider_name}, मी तुमची प्रोफाइल पाहिली. मला सेवेबद्दल चौकशी करायची आहे.`
    : `Hello ${vendor.provider_name}, I found your profile on Aheka (aheka.in) and would like to inquire about your service.`
);
const waNumberClean = vendor.whatsapp_number
  ? vendor.whatsapp_number.replace(/[^\d]/g, '')
  : vendor.mobile.replace(/[^\d]/g, '');
const waHref = `https://wa.me/${waNumberClean}?text=${waText}`;

// Initials for avatar fallback
const initials = vendor.provider_name
  .split(' ')
  .slice(0, 2)
  .map(n => n.charAt(0))
  .join('');

// Schema.org LocalBusiness JSON-LD
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: vendor.provider_name,
  legalName: vendor.business_name || vendor.provider_name,
  telephone: vendor.mobile,
  url: currentUrl,
  image: vendor.profile_image_url || `${siteUrl}/icons/icon-512.png`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: vendor.full_address,
    addressLocality: talukaName,
    addressRegion: 'Maharashtra',
    addressCountry: 'IN',
  },
  ...(vendor.latitude && vendor.longitude ? {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: vendor.latitude,
      longitude: vendor.longitude,
    }
  } : {}),
  description: localizedDescription || pageDesc,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: dict.directory.breadcrumbsHome,
      item: `${siteUrl}/${safeLocale}`,
    },
    ...(primaryListing && districtSlug ? [
      {
        '@type': 'ListItem',
        position: 2,
        name: talukaName,
        item: `${siteUrl}/${safeLocale}/${districtSlug}/${primaryListing.taluka.slug}`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: primaryCategoryName,
        item: `${siteUrl}/${safeLocale}/${districtSlug}/${primaryListing.taluka.slug}/${primaryListing.category.slug}`,
      },
    ] : []),
    {
      '@type': 'ListItem',
      position: primaryListing ? 4 : 2,
      name: vendor.provider_name,
      item: currentUrl,
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  locale={safeLocale}
  canonicalPath={`/${safeLocale}/provider/${vendor.slug}`}
  currentTalukaName={talukaName}
  schemaJsonLd={[breadcrumbSchema, localBusinessSchema]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 overflow-x-auto whitespace-nowrap py-1 text-xs sm:text-sm text-ink-muted mb-6" aria-label="Breadcrumb">
      <a href={`/${safeLocale}`} class="shrink-0 hover:text-brand-600 transition-colors">
        {dict.directory.breadcrumbsHome}
      </a>
      {primaryListing && districtSlug && (
        <>
          <span class="shrink-0">/</span>
          <a href={`/${safeLocale}/${districtSlug}/${primaryListing.taluka.slug}`} class="shrink-0 hover:text-brand-600 transition-colors">
            {talukaName}
          </a>
          <span class="shrink-0">/</span>
          <a href={`/${safeLocale}/${districtSlug}/${primaryListing.taluka.slug}/${primaryListing.category.slug}`} class="shrink-0 hover:text-brand-600 transition-colors">
            {primaryCategoryName}
          </a>
        </>
      )}
      <span class="shrink-0">/</span>
      <span class="shrink-0 text-ink-primary font-medium">
        {vendor.provider_name}
      </span>
    </nav>

    <!-- Main Profile Card -->
    <div class="bg-white dark:bg-ink-surface rounded-3xl border border-surface-border p-6 sm:p-10 shadow-soft">
      
      <!-- Top Section: Photo & Header -->
      <div class="flex flex-col sm:flex-row items-start gap-6 pb-8 border-b border-surface-border">
        
        <!-- Profile Photo / Monogram (Policy: Exactly one optional photo) -->
        <div class="relative flex-shrink-0">
          {vendor.profile_image_url ? (
            <img
              src={vendor.profile_image_url}
              alt={`${vendor.provider_name} - ${vendor.business_name || primaryCategoryName}`}
              class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover border border-surface-border shadow-xs"
              width="112"
              height="112"
            />
          ) : (
            <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-brand-50 dark:bg-brand-950/60 border border-brand-200 dark:border-brand-900/60 flex items-center justify-center text-brand-700 dark:text-brand-300 font-bold text-3xl shadow-xs">
              {initials || 'A'}
            </div>
          )}

          {vendor.is_verified && (
            <div
              class="absolute -bottom-1 -right-1 bg-green-600 text-white p-1.5 rounded-full shadow-xs"
              title={dict.directory.verifiedTooltip}
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </div>
          )}
        </div>

        <!-- Identity & Badges -->
        <div class="flex-1">
          <div class="flex items-center gap-2.5 flex-wrap">
            <h1 class="text-2xl sm:text-3xl font-black text-ink-primary">
              {vendor.provider_name}
            </h1>
            {vendor.is_verified && (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-200">
                <span>✓ {isMr ? 'पडताळलेली प्रोफाइल' : 'Verified by Aheka'}</span>
              </span>
            )}
          </div>

          {vendor.business_name && (
            <p class="text-base sm:text-lg font-semibold text-brand-700 mt-1">
              {vendor.business_name}
            </p>
          )}

          <!-- Taluka & Experience Badges -->
          <div class="flex items-center gap-3 mt-3 flex-wrap text-xs sm:text-sm text-ink-secondary">
            {talukaName && (
              <span class="inline-flex items-center gap-1.5 bg-brand-50 text-brand-800 px-3 py-1 rounded-full font-medium border border-brand-200">
                <svg class="w-4 h-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>{talukaName}, {districtName}</span>
              </span>
            )}

            {vendor.experience_years > 0 && (
              <span class="inline-flex items-center gap-1.5 bg-surface-muted text-ink-primary px-3 py-1 rounded-full font-medium border border-surface-border">
                <svg class="w-4 h-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{vendor.experience_years} {dict.directory.years} {dict.directory.experience}</span>
              </span>
            )}
          </div>
        </div>

      </div>

      <!-- Action Buttons Row -->
      <div class="py-6 border-b border-surface-border flex flex-wrap items-center gap-3">
        <!-- Call Button -->
        <a
          href={`tel:${vendor.mobile}`}
          data-vendor-id={vendor.id}
          data-action="call_click"
          class="action-track-btn inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-bold text-sm sm:text-base shadow-sm transition-colors flex-1 sm:flex-initial"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>{dict.actions.callNow}</span>
        </a>

        <!-- WhatsApp Button -->
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          data-vendor-id={vendor.id}
          data-action="whatsapp_click"
          class="action-track-btn inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-[#25D366] hover:bg-[#1ebd5a] text-white font-bold text-sm sm:text-base shadow-sm transition-colors flex-1 sm:flex-initial"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
          </svg>
          <span>{dict.actions.whatsapp}</span>
        </a>

        {vendor.google_maps_url && (
          <a
            href={vendor.google_maps_url}
            target="_blank"
            rel="noopener noreferrer"
            data-vendor-id={vendor.id}
            data-action="directions_click"
            class="action-track-btn inline-flex items-center justify-center gap-1.5 px-4 py-3.5 rounded-2xl border border-surface-border text-ink-primary hover:bg-surface-muted transition-colors text-sm font-semibold"
          >
            <svg class="w-4 h-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{dict.actions.getDirections}</span>
          </a>
        )}

        <!-- Share Button Island -->
        <ShareButton
          client:idle
          title={`${vendor.provider_name} - ${vendor.business_name || primaryCategoryName}`}
          text={shareText}
          url={currentUrl}
          locale={safeLocale}
          className="px-4 py-3.5 rounded-2xl text-sm"
        />
      </div>

      <!-- Details Sections -->
      <div class="pt-8 space-y-8">
        
        <!-- About / Description -->
        {localizedDescription && (
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-brand-700 mb-2">
              {isMr ? 'व्यवसायाबद्दल माहिती' : 'About Business'}
            </h2>
            <p class="text-sm sm:text-base text-ink-secondary leading-relaxed whitespace-pre-line">
              {localizedDescription}
            </p>
          </div>
        )}

        <!-- Address -->
        <div>
          <h2 class="text-sm font-bold uppercase tracking-wider text-brand-700 mb-2">
            {dict.directory.fullAddress}
          </h2>
          <p class="text-sm sm:text-base text-ink-secondary flex items-start gap-2">
            <svg class="w-5 h-5 text-brand-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{vendor.full_address}</span>
          </p>
        </div>

        <!-- Service Areas Covered -->
        {localizedServiceAreas.length > 0 && (
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-brand-700 mb-2">
              {dict.directory.serviceAreas} ({talukaName})
            </h2>
            <div class="flex flex-wrap gap-2">
              {localizedServiceAreas.map((area) => (
                <span class="px-3 py-1 rounded-lg bg-surface-muted border border-surface-border text-xs sm:text-sm text-ink-secondary font-medium">
                  {area}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Services / Categories Offered -->
        <div>
          <h2 class="text-sm font-bold uppercase tracking-wider text-brand-700 mb-2">
            {isMr ? 'उपलब्ध सेवा' : 'Services Offered'}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {listings.map((l) => (
              <a
                href={`/${safeLocale}/${l.taluka.district?.slug || 'ahilyanagar'}/${l.taluka.slug}/${l.category.slug}`}
                class="flex items-center justify-between p-3.5 rounded-xl border border-surface-border hover:border-brand-500 bg-surface-canvas hover:bg-white transition-all group"
              >
                <span class="font-bold text-sm text-ink-primary group-hover:text-brand-600">
                  {isMr ? l.category.name_mr : l.category.name_en}
                </span>
                <span class="text-xs text-brand-700 font-semibold group-hover:underline">
                  {isMr ? l.taluka.name_mr : l.taluka.name_en} →
                </span>
              </a>
            ))}
          </div>
        </div>

      </div>

    </div>

    <!-- Trust & Verification Notice -->
    <div class="mt-8 p-4 rounded-2xl bg-brand-50/70 border border-brand-200 text-xs text-brand-900 flex items-start gap-3">
      <svg class="w-5 h-5 text-brand-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <div>
        <span class="font-bold">{isMr ? 'थेट संपर्क सूचना:' : 'Direct Contact Notice:'}</span>{' '}
        {isMr
          ? 'या प्लॅटफॉर्मवर ग्राहक आणि सेवा प्रदात्यांमध्ये कोणताही मध्यस्थ नाही. कामाचे दर, वेळ आणि अटी थेट सेवा प्रदात्याशी ठरवा.'
          : 'Aheka connects you directly with local service providers with zero commission. Discuss work terms, rates, and timing directly with the technician.'}
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  // Page view analytics (fire once on load)
  try {
    fetch('/api/analytics/event', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        event_type: 'profile_view',
        page_path: window.location.pathname,
        locale: window.location.pathname.split('/')[1] === 'mr' ? 'mr' : 'en',
      }),
    }).catch(() => {});
  } catch {}

  // Action clicks tracking
  document.querySelectorAll<HTMLElement>('.action-track-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const vendorId = btn.dataset.vendorId;
      const action = btn.dataset.action;
      if (vendorId && action) {
        fetch('/api/analytics/event', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            vendor_id: vendorId,
            event_type: action,
            page_path: window.location.pathname,
            locale: window.location.pathname.split('/')[1] === 'mr' ? 'mr' : 'en',
          }),
        }).catch(() => {});
      }
    });
  });
</script>
