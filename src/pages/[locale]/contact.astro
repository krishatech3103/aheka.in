---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary, isValidLocale, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { getDataRepository } from '../../lib/repositories/dataRepository';

const { locale } = Astro.params;
if (!locale || !isValidLocale(locale)) {
  return Astro.redirect(`/${DEFAULT_LOCALE}`, 302);
}

const safeLocale = locale as Locale;
const dict = getDictionary(safeLocale);
const isMr = safeLocale === 'mr';
const repo = getDataRepository();
const settings = await repo.getSiteSettings();

const phoneNumber = settings.support_mobile.trim();
const phoneHref = phoneNumber.replace(/[^+\d]/g, '');
const whatsappNumber = settings.support_whatsapp.replace(/\D/g, '');
const email = settings.business_email.trim();
const pageTitle = isMr ? 'आमच्याशी संपर्क करा — आहे का?' : 'Contact Aheka';
const pageDescription = isMr
  ? 'स्थानिक सेवा किंवा सेवा प्रदाता शोधण्यासाठी आहे का? टीमशी संपर्क करा.'
  : 'Contact Aheka for help finding local services and service providers in your area.';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: pageTitle,
  mainEntity: {
    '@type': 'Organization',
    name: isMr ? dict.brand.devanagariName : dict.brand.name,
    telephone: phoneNumber,
    email,
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: phoneNumber,
      contactType: 'customer support',
      availableLanguage: isMr ? 'Marathi' : 'English',
    },
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  locale={safeLocale}
  canonicalPath={`/${safeLocale}/contact`}
  schemaJsonLd={contactSchema}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="text-center max-w-2xl mx-auto">
      <span class="inline-flex px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-950/60 border border-brand-200 dark:border-brand-800 text-brand-700 dark:text-brand-300 text-xs font-bold">
        {dict.contactPage.badge}
      </span>
      <h1 class="mt-4 text-3xl sm:text-5xl font-black text-ink-primary tracking-tight text-balance">
        {dict.contactPage.title}
      </h1>
      <p class="mt-3 text-sm sm:text-base text-ink-secondary leading-relaxed text-balance">
        {dict.contactPage.description}
      </p>
    </div>

    <div class="mt-8 sm:mt-12 grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
      <a
        href={phoneHref ? `tel:${phoneHref}` : undefined}
        class="group rounded-2xl bg-white dark:bg-ink-surface border border-surface-border p-5 sm:p-6 shadow-soft hover:border-brand-500 hover:shadow-md transition-all"
      >
        <div class="w-11 h-11 rounded-xl bg-brand-50 dark:bg-brand-950/60 text-brand-600 dark:text-brand-400 flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.95.684l1.5 4.493a1 1 0 01-.502 1.21l-2.257 1.128a11.042 11.042 0 005.516 5.516l1.128-2.257a1 1 0 011.21-.502l4.493 1.5A1 1 0 0121 15.72V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <h2 class="mt-4 font-bold text-ink-primary group-hover:text-brand-700 dark:group-hover:text-brand-300 transition-colors">
          {dict.contactPage.callTitle}
        </h2>
        <p class="mt-1 text-xs sm:text-sm text-ink-secondary leading-relaxed">{dict.contactPage.callDescription}</p>
        <p class="mt-4 text-sm font-bold text-brand-600 dark:text-brand-400">{phoneNumber}</p>
      </a>

      <a
        href={whatsappNumber ? `https://wa.me/${whatsappNumber}` : undefined}
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-2xl bg-white dark:bg-ink-surface border border-surface-border p-5 sm:p-6 shadow-soft hover:border-brand-500 hover:shadow-md transition-all"
      >
        <div class="w-11 h-11 rounded-xl bg-brand-50 dark:bg-brand-950/60 text-brand-600 dark:text-brand-400 flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 11.5a8.38 8.38 0 01-9 8.25 9.52 9.52 0 01-4.26-1.22L3 20l1.44-4.15A8.26 8.26 0 013 11.5a8.5 8.5 0 0117 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.65 7.9c.18-.4.37-.4.55-.4h.47c.15 0 .35.06.45.35l.65 1.58c.08.21.04.37-.05.52l-.3.37c-.1.12-.2.25-.09.47.11.21.5.82 1.08 1.33.74.66 1.36.86 1.57.97.2.1.33.08.45-.05l.57-.67c.13-.15.28-.12.47-.05l1.5.7c.24.1.4.15.46.24.06.09.06.52-.13 1.02-.18.5-1.06.95-1.46 1.01-.38.06-.86.1-1.39-.07-.32-.1-.73-.24-1.25-.46-.52-.22-2.17-.8-3.69-2.2-1.18-1.09-1.98-2.44-2.21-2.85-.23-.4-.02-.62.17-.81l.32-.37c.1-.12.13-.2.2-.33.06-.13.03-.25-.02-.35l-.65-1.57c-.16-.38-.32-.33-.45-.34h-.39c-.13 0-.35.05-.53.25-.18.2-.7.68-.7 1.66s.72 1.94.82 2.07" />
          </svg>
        </div>
        <h2 class="mt-4 font-bold text-ink-primary group-hover:text-brand-700 dark:group-hover:text-brand-300 transition-colors">
          {dict.contactPage.whatsappTitle}
        </h2>
        <p class="mt-1 text-xs sm:text-sm text-ink-secondary leading-relaxed">{dict.contactPage.whatsappDescription}</p>
        <p class="mt-4 text-sm font-bold text-brand-600 dark:text-brand-400">{settings.support_whatsapp}</p>
      </a>

      <a
        href={email ? `mailto:${encodeURIComponent(email)}` : undefined}
        class="group rounded-2xl bg-white dark:bg-ink-surface border border-surface-border p-5 sm:p-6 shadow-soft hover:border-brand-500 hover:shadow-md transition-all"
      >
        <div class="w-11 h-11 rounded-xl bg-brand-50 dark:bg-brand-950/60 text-brand-600 dark:text-brand-400 flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2.4 2.4 0 002.22 0L21 8m-18 8h18a2 2 0 002-2V6a2 2 0 00-2-2H3a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </div>
        <h2 class="mt-4 font-bold text-ink-primary group-hover:text-brand-700 dark:group-hover:text-brand-300 transition-colors">
          {dict.contactPage.emailTitle}
        </h2>
        <p class="mt-1 text-xs sm:text-sm text-ink-secondary leading-relaxed">{dict.contactPage.emailDescription}</p>
        <p class="mt-4 text-sm font-bold text-brand-600 dark:text-brand-400 break-all">{email}</p>
      </a>
    </div>

    <section class="mt-8 sm:mt-12 rounded-3xl bg-surface-muted/70 dark:bg-ink-surface border border-surface-border p-6 sm:p-10 text-center">
      <h2 class="text-xl sm:text-2xl font-black text-ink-primary">{dict.contactPage.helpTitle}</h2>
      <p class="mt-2 max-w-xl mx-auto text-sm text-ink-secondary leading-relaxed">{dict.contactPage.helpDescription}</p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a
          href={`/${safeLocale}/services`}
          class="inline-flex items-center justify-center rounded-xl bg-white dark:bg-ink-surface border border-surface-border px-4 py-2.5 text-sm font-bold text-ink-primary hover:border-brand-500 hover:text-brand-700 dark:hover:text-brand-300 transition-colors"
        >
          {dict.contactPage.browseServices}
        </a>
        <button
          type="button"
          onclick="document.getElementById('location-dialog')?.showModal()"
          class="inline-flex items-center justify-center rounded-xl bg-white dark:bg-ink-surface border border-surface-border px-4 py-2.5 text-sm font-bold text-ink-primary hover:border-brand-500 hover:text-brand-700 dark:hover:text-brand-300 transition-colors"
        >
          {dict.contactPage.chooseLocation}
        </button>
        <a
          href={`/${safeLocale}/join`}
          class="inline-flex items-center justify-center rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700 transition-colors"
        >
          {dict.contactPage.listService}
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
