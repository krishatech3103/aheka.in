---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary, isValidLocale, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';

const { locale } = Astro.params;
if (!locale || !isValidLocale(locale)) {
  return Astro.redirect(`/${DEFAULT_LOCALE}`, 302);
}

const safeLocale = locale as Locale;
const isMr = safeLocale === 'mr';

const pageTitle = isMr ? 'सेवा प्रदाता अटी (Provider Terms) | Aheka' : 'Service Provider Terms | Aheka';
const pageDesc = isMr
  ? 'Aheka वर नाव नोंदवणाऱ्या कारागीर आणि व्यावसायिकांसाठी वर्गणी, नियम व अटी.'
  : 'Subscription policies, 10-slot limit rules, and fair rotation terms for registered providers.';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  locale={safeLocale}
  canonicalPath={`/${safeLocale}/provider-terms`}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="bg-white rounded-3xl border border-surface-border p-6 sm:p-12 shadow-soft space-y-6 text-ink-secondary text-sm sm:text-base leading-relaxed">
      <span class="inline-block px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-bold border border-brand-200 mb-2">
        {isMr ? 'कारागीर व व्यावसायिक नियमावली' : 'Vendor Operating Policy'}
      </span>
      <h1 class="text-2xl sm:text-4xl font-black text-ink-primary tracking-tight">
        {isMr ? 'सेवा प्रदाता अटी (Provider Terms)' : 'Provider Subscription & Listing Terms'}
      </h1>
      <p class="text-xs text-ink-muted">
        {isMr ? 'शेवटचे अद्यतन: ७ सप्टेंबर २०२६' : 'Last updated: September 7, 2026'}
      </p>

      <section class="space-y-3">
        <h2 class="text-lg font-bold text-ink-primary">
          {isMr ? '१. वार्षिक वर्गणी आणि परतावा धोरण' : '1. Annual Subscription & Refund Policy'}
        </h2>
        <p>
          {isMr
            ? 'Aheka वरील प्रत्येक सेवेसाठी वार्षिक वर्गणी ₹९९९ (किंवा त्यावेळचे अधिकृत शुल्क) आहे. वर्गणी ३६५ दिवसांसाठी वैध राहते. सक्रिय झाल्यानंतर वर्गणीचा परतावा (refund) दिला जात नाही.'
            : 'The annual listing subscription is ₹999 per service category per taluka, valid for 365 calendar days. Subscriptions are non-refundable once activated.'}
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-bold text-ink-primary">
          {isMr ? '२. १० जागांची वाजवी मर्यादा (Slot Limits)' : '2. 10-Slot Limit Policy'}
        </h2>
        <p>
          {isMr
            ? 'प्रत्येक तालुक्यात प्रत्येक सेवेसाठी जास्तीत जास्त १० सक्रिय जागा असतात. १० जागा पूर्ण असल्यास नवीन अर्जदारांना प्रतीक्षा यादीत (Waitlist) ठेवले जाते. जागा रिकामी झाल्यावर प्रतीक्षा यादीनुसार संधी दिली जाते.'
            : 'Each taluka enforces a strict maximum of 10 active listings per category. When 10 slots are full, approved applicants are placed on a transparent waitlist and activated in order as existing subscriptions expire.'}
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-bold text-ink-primary">
          {isMr ? '३. पारदर्शक दैनिक फेरबदल (Daily Fair Rotation)' : '3. Deterministic Daily Fair Rotation'}
        </h2>
        <p>
          {isMr
            ? 'सर्व १० कारागिरांना समान ग्राहक मिळावेत यासाठी दररोज रात्री १२:०० वाजता (IST) यादीतील क्रम संगणकीय नियमाने बदलला जातो. कोणताही कारागीर पैसे देऊन प्रथम क्रमांकाची जागा विकत घेऊ शकत नाही.'
            : 'All 10 providers in a taluka rotate daily at midnight IST to guarantee equal visibility. Paid sponsorship or paying extra to stay at the top is strictly prohibited.'}
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-bold text-ink-primary">
          {isMr ? '४. एक फोटो धोरण (Single Image Policy)' : '4. Single Image Policy'}
        </h2>
        <p>
          {isMr
            ? 'प्लॅटफॉर्मचा वेग जलद राहण्यासाठी आणि डेटा बचत होण्यासाठी प्रत्येक कारागिराला जास्तीत जास्त १ प्रोफाईल किंवा दुकानाचा फोटो अपलोड करण्याची परवानगी आहे.'
            : 'To maintain sub-second page loads on rural 3G/4G networks, each provider is permitted exactly one optimized profile or workshop photo.'}
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-bold text-ink-primary">
          {isMr ? '५. निलंबन आणि गैरवर्तन धोरण' : '5. Suspension Policy'}
        </h2>
        <p>
          {isMr
            ? 'ग्राहकांसोबत गैरवर्तन, खोटी माहिती किंवा बेकायदेशीर कामाच्या तक्रारींची खात्री झाल्यास Aheka ला प्रोफाईल तात्काळ निलंबित करण्याचा अधिकार आहे.'
            : 'Aheka reserves the right to suspend any listing without refund if the provider engages in fraud, harassment, or provides inaccurate contact details.'}
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
