SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
TURNSTILE_SECRET_KEY=0x4AAAAAA...
ADMIN_SESSION_SECRET=random_32_character_string_for_cookie_signing
ADMIN_ENTRY_PATH=your-private-admin-path
ADMIN_PASSWORD=your-super-admin-password

# Optional Local Dev Config
PORT=4321
HOST=0.0.0.0
